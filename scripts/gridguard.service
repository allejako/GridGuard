[Unit]
Description=GridGuard Energy Optimization Daemon
After=network.target

[Service]
Type=forking
PIDFile=/tmp/gridguard.pid
ExecStart=/usr/local/bin/GridGuard-watchdog --daemon-path /usr/local/bin/GridGuard-server
ExecStop=/bin/kill -TERM $MAINPID
Restart=on-failure
RestartSec=10s
TimeoutStopSec=30

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gridguard

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/tmp /var/log

[Install]
WantedBy=multi-user.target
